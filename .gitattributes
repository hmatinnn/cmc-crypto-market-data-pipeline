# All text files are stored with LF line endings in the repository.
# Reason: this project runs on Linux/Docker. Shell scripts and entrypoint files
# with CRLF endings fail inside containers with "bad interpreter" errors, and
# files edited on Windows produce artificially huge git diffs.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gz   binary
*.zip  binary
