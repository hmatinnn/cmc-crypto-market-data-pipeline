# Airflow generates this file itself and writes fernet_key / secret_key /
# jwt_secret into it. Every meaningful setting is already supplied through
# AIRFLOW__* environment variables in docker-compose.yaml, so the file must not
# be committed.
config/airflow.cfg
config/*.cfg
!config/.gitkeep

