.env
.venv/
logs/
api_responses/
api_responses_csv/
__pycache__/
secrets/*.json

# Airflow generates this file itself and writes fernet_key / secret_key /
# jwt_secret into it. Every meaningful setting is already supplied through
# AIRFLOW__* environment variables in docker-compose.yaml, so the file must not
# be committed.
config/airflow.cfg
config/*.cfg
!config/.gitkeep

# NOTE: dbt/cmc_pipeline/profiles.yml is intentionally NOT ignored. It reads
# every value from environment variables, so it contains no secrets, and
# committing it means a fresh clone can run dbt without any manual setup.
dbt/cmc_pipeline/target/
dbt/cmc_pipeline/target_daily/
dbt/cmc_pipeline/target_weekly/
dbt/cmc_pipeline/target_monthly/
dbt/cmc_pipeline/logs/
dbt/cmc_pipeline/dbt_packages/

