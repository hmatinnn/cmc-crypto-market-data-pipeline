# NOTE: the previous file was named "dockerignore" (no leading dot), so Docker
# never read it and the build context included .venv/ (243MB), logs/,
# api_responses/ and similar directories. This file replaces it.

.git
.gitignore
.gitattributes
.github
.dockerignore
dockerignore

