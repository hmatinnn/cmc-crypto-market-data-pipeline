# ==============================================================
# CoinMarketCap Data Pipeline — environment configuration
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# The real `.env` is gitignored — NEVER commit secrets.
# ==============================================================

# --- Network exposure ------------------------------------------
# Which host interface the web UIs are published on.
#
#   127.0.0.1  (default) - reachable only from THIS machine. Correct for a
#                          laptop: http://localhost:8080 works as usual, but
#                          nobody else on the network can reach it.
#   0.0.0.0              - reachable from anywhere. Only set this on a server
#                          you intend to expose, and only after setting strong
#                          passwords below.
#
# Postgres is always bound to 127.0.0.1 and is never published publicly; use an
# SSH tunnel to reach a remote one (see README, "Querying the warehouse").
BIND_HOST=127.0.0.1

# --- Airflow ---------------------------------------------------
# Host user id that owns mounted files (Linux/macOS: run `id -u`; Windows: leave 50000)
AIRFLOW_UID=50000
# Login for the Airflow web UI. LEAVING THIS EMPTY MEANS airflow/airflow, which
# is the documented default in a public repository - always set it on a server
# whose port 8080 is reachable from the internet.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=
# Fernet key for encrypting Airflow connections. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- CoinMarketCap API -----------------------------------------
# Get a free key at https://pro.coinmarketcap.com/signup
X_CMC_PRO_API_KEY=

# --- Data warehouse (Postgres) ---------------------------------
# Host and user are the compose defaults - leave them unless you changed the
# service name. The password is applied when the volume is FIRST created; on an
# existing volume it must be changed with ALTER USER instead.
POSTGRES_HOST=postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=

# --- Telegram alerting -----------------------------------------
# Create a bot with @BotFather to get the token.
# Get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Grafana admin ---------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# --- Superset admin --------------------------------------------
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@example.com
