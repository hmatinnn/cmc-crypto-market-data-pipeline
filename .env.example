# ==============================================================
# CoinMarketCap Data Pipeline — environment configuration
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# The real `.env` is gitignored — NEVER commit secrets.
# ==============================================================

# --- Airflow ---------------------------------------------------
# Host user id that owns mounted files (Linux/macOS: run `id -u`; Windows: leave 50000)
AIRFLOW_UID=50000
# Fernet key for encrypting Airflow connections. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- CoinMarketCap API -----------------------------------------
# Get a free key at https://pro.coinmarketcap.com/signup
X_CMC_PRO_API_KEY=

# --- Data warehouse (Postgres) ---------------------------------
POSTGRES_PASSWORD=

# --- Telegram alerting -----------------------------------------
# Create a bot with @BotFather to get the token.
# Get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Grafana admin ---------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# --- Superset admin --------------------------------------------
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@example.com
